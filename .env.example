# 国内站账户。不要使用国际站密钥。
MINIMAX_SITE=cn
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=
# Render 环境变量页面填写密钥；不要写入前端。

# 自定义域名时填完整 https://域名；Render 默认域名自动读取 RENDER_EXTERNAL_URL
# APP_ORIGIN=

# 常规请求诊断：默认开启；0 关闭，1 明确开启。不记录完整输入/输出。
REQUEST_DIAGNOSTICS=1
# 仅合成测试的单例输出取证，默认关闭。需同时填写随机UUID、24小时以内的UTC截止时间，
# 并在该次表单补充背景添加 [诊断:相同UUID]。用完删除这两个变量。
# DIAGNOSTIC_CASE_ID=
# DIAGNOSTIC_CASE_EXPIRES_AT=

# 仅故事思考开关；adaptive恢复开启，聊天不受影响。
MINIMAX_STORY_THINKING=disabled
# 单实例故事与聊天共用并发上限（1至5）；默认3，无排队。
MODEL_MAX_CONCURRENT=3
